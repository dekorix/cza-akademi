# Central student record service. Keep the deployed value in the hosting secret store.
CZA_CORE_API_URL=https://your-central-student-service.example/

# Central educator reporting service. Keep the deployed value in the hosting secret store.
CZA_EDUCATOR_REPORT_URL=https://your-central-educator-service.example/educator-report
CZA_NEON_AUTH_BASE_URL=https://your-neon-auth.example/auth
DATABASE_URL=postgresql://server-only-connection-string
CZA_NEON_AUTH_BASE_URL=https://your-neon-auth.example/auth
DATABASE_URL=postgresql://server-only-connection-string

# Premium Turkish TTS. Leave unset until a provider and approved voice are ready.
CZA_TTS_PROVIDER=openai
OPENAI_API_KEY=
CZA_TTS_VOICE_ID=
CZA_TTS_PROFILE_NAME=
CZA_TTS_MODEL=gpt-4o-mini-tts
CZA_TTS_VOICE_VERSION=1

# Student campus-code mapping must live in the central record service, not in this file.
