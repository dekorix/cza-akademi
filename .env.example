# Central student record service. Keep the deployed value in the hosting secret store.
CZA_CORE_API_URL=https://your-central-student-service.example/
# Comma-separated exact host allowlist. Startup/request handling fails closed
# when either this value or CZA_CORE_API_URL is missing or mismatched.
CZA_CORE_API_ALLOWED_HOSTS=your-central-student-service.example
# Production rate limiting accepts client IPs only inside Cloudflare Workers,
# where request.cf is runtime-injected and CF-Connecting-IP is overwritten.
# A direct/non-Cloudflare origin request fails closed.
CZA_TRUSTED_EDGE=cloudflare

# Central educator reporting service. Keep the deployed value in the hosting secret store.
CZA_EDUCATOR_REPORT_URL=https://your-central-educator-service.example/educator-report
CZA_NEON_AUTH_BASE_URL=https://your-neon-auth.example/auth
CZA_TRUSTED_PROXY_HMAC_SECRET=replace-with-at-least-32-random-bytes
# Least-privilege application login; it must be a member of cza_app_runtime.
DATABASE_URL=postgresql://runtime-role-server-only-connection-string
# Direct, non-pooler connection used only by migrations and PostgreSQL tests.
DATABASE_URL_UNPOOLED=postgresql://migration-role-direct-connection-string

# Premium Turkish TTS. Leave unset until a provider and approved voice are ready.
CZA_TTS_PROVIDER=openai
OPENAI_API_KEY=
CZA_TTS_VOICE_ID=
CZA_TTS_PROFILE_NAME=
CZA_TTS_MODEL=gpt-4o-mini-tts
CZA_TTS_VOICE_VERSION=1

# Student campus-code mapping must live in the central record service, not in this file.
