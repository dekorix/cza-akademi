{
  // Fragment only; NEVER deploy this as a complete ingress configuration.
  "services": [
    { "binding": "QA_EDUCATOR_HISTORY_BROKER", "service": "private-educator-broker-placeholder" }
  ],
  "vars": {
    "QA_BROKER_STUDENT_ID": "REVIEW_PLACEHOLDER",
    "QA_BROKER_ACADEMY_ID": "REVIEW_PLACEHOLDER"
  }
  // QA_BROKER_REQUEST_HMAC_SECRET is the same Worker secret as the broker, never a var.
  // Do not add another service binding here. The nonce ledger binding belongs only on the broker.
}
